{
  "name": "@brobridgejs/adapters",
  "version": "0.2.3",
  "type": "module",
  "description": "brobridge adapters for birpc, oRPC and tRPC",
  "license": "MIT",
  "author": "brobridge contributors",
  "homepage": "https://github.com/praveenvijayan/brobridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenvijayan/brobridge.git",
    "directory": "packages/adapters"
  },
  "bugs": {
    "url": "https://github.com/praveenvijayan/brobridge/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./birpc": {
      "types": "./dist/birpc.d.ts",
      "default": "./dist/birpc.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "default": "./dist/orpc.js"
    },
    "./trpc": {
      "types": "./dist/trpc.d.ts",
      "default": "./dist/trpc.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "keywords": [
    "brobridge",
    "adapter",
    "birpc",
    "orpc",
    "trpc"
  ],
  "dependencies": {
    "@brobridgejs/core": "workspace:^"
  },
  "peerDependencies": {
    "birpc": "^2.5.0 || ^3.0.0 || ^4.0.0",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "birpc": {
      "optional": true
    },
    "@orpc/client": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "@trpc/client": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@brobridgejs/client": "workspace:^",
    "brobridge": "workspace:^",
    "birpc": "4.2.0",
    "@orpc/client": "1.15.0",
    "@orpc/server": "1.15.0",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "ws": "^8.21.3",
    "@types/ws": "^8.18.1",
    "zod": "^4.1.12"
  }
}
