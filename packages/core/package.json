{
  "name": "@brobridgejs/core",
  "version": "0.2.1",
  "type": "module",
  "description": "brobridge protocol core: frame codec, stream multiplexing, credit flow control, resume",
  "license": "MIT",
  "author": "brobridge contributors",
  "homepage": "https://github.com/praveenvijayan/brobridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenvijayan/brobridge.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/praveenvijayan/brobridge/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "brobridge",
    "protocol",
    "framing",
    "multiplexing",
    "flow-control",
    "resume"
  ],
  "devDependencies": {
    "fast-check": "^4.9.0"
  }
}
