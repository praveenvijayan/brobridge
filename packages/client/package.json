{
  "name": "@brobridgejs/client",
  "version": "0.1.0",
  "type": "module",
  "description": "brobridge browser client: reconnect, resume, typed calls and streams",
  "license": "MIT",
  "author": "brobridge contributors",
  "homepage": "https://github.com/praveenvijayan/brobridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenvijayan/brobridge.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/praveenvijayan/brobridge/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "size": "node ../../scripts/check-client-size.mjs",
    "test:bun": "bun test tests-bun"
  },
  "keywords": [
    "brobridge",
    "browser",
    "websocket",
    "client",
    "reconnect",
    "resume"
  ],
  "dependencies": {
    "@brobridgejs/core": "workspace:^"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "brobridge": "workspace:^",
    "playwright": "1.62.1",
    "ws": "^8.21.3"
  }
}
